      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Document age",
      "description": "How long ago the cluster-autoscaler last wrote the status ConfigMap. A rising value means the autoscaler stopped updating it, even while the exporter is up.",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "time() - max(cluster_autoscaler_status_document_timestamp_seconds{job=\"$job\"})",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "s",
          "decimals": 0,
          "noValue": "No data",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 120
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "At max size",
      "description": "Node groups whose cloud-provider target has reached maxSize \u2014 they cannot scale up any further.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "count(\n  cluster_autoscaler_status_node_group_target_size{job=\"$job\", node_group=~\"$node_group\"}\n  >= on(node_group) cluster_autoscaler_status_node_group_max_size{job=\"$job\", node_group=~\"$node_group\"}\n) or vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "In backoff",
      "description": "Node groups the cluster-autoscaler has given up scaling up for now, after a failed attempt.",
      "gridPos": {
        "x": 21,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "count(cluster_autoscaler_status_node_group_scale_up_backoff{job=\"$job\", node_group=~\"$node_group\"} == 1) or vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      }
    },
    {
      "id": 100,
      "type": "row",
      "title": "Node groups",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "table",
      "title": "Capacity",
      "description": "Sorted by how close each node group is to its ceiling. 100% of max means the autoscaler cannot add another node there.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "max by (node_group) (cluster_autoscaler_status_node_group_min_size{job=\"$job\", node_group=~\"$node_group\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "max by (node_group) (cluster_autoscaler_status_node_group_target_size{job=\"$job\", node_group=~\"$node_group\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "max by (node_group) (cluster_autoscaler_status_node_group_max_size{job=\"$job\", node_group=~\"$node_group\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        },
        {
          "refId": "D",
          "editorMode": "code",
          "expr": "max by (node_group) (cluster_autoscaler_status_node_group_nodes{job=\"$job\", node_group=~\"$node_group\", state=\"ready\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        },
        {
          "refId": "E",
          "editorMode": "code",
          "expr": "max by (node_group) (cluster_autoscaler_status_node_group_nodes{job=\"$job\", node_group=~\"$node_group\", state=\"unready\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        },
        {
          "refId": "F",
          "editorMode": "code",
          "expr": "max by (node_group) (cluster_autoscaler_status_node_group_scale_down_candidates{job=\"$job\", node_group=~\"$node_group\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        },
        {
          "refId": "G",
          "editorMode": "code",
          "expr": "100\n  * max by (node_group) (cluster_autoscaler_status_node_group_target_size{job=\"$job\", node_group=~\"$node_group\"})\n  / (max by (node_group) (cluster_autoscaler_status_node_group_max_size{job=\"$job\", node_group=~\"$node_group\"}) > 0)",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "node_group",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "pattern": "/^Time/"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {},
            "indexByName": {
              "node_group": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #G": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7
            },
            "renameByName": {
              "node_group": "Node group",
              "Value #A": "Min",
              "Value #B": "Target",
              "Value #C": "Max",
              "Value #D": "Ready",
              "Value #E": "Unready",
              "Value #F": "Removable",
              "Value #G": "% of max"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Node group"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 520
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(Min|Target|Max|Ready|Unready)$/"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Removable"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unready"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "% of max"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 80
                    },
                    {
                      "color": "red",
                      "value": 100
                    }
                  ]
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "% of max",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Conditions",
      "description": "The health, scale-up and scale-down condition each node group is currently in, plus the cloud-provider error code while a scale-up is in backoff.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "max by (node_group, health) (\n  label_replace(\n    cluster_autoscaler_status_node_group_health_state{job=\"$job\", node_group=~\"$node_group\"} == 1,\n    \"health\", \"$1\", \"state\", \"(.*)\"\n  )\n)",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "max by (node_group, scale_up) (\n  label_replace(\n    cluster_autoscaler_status_node_group_scale_up_state{job=\"$job\", node_group=~\"$node_group\"} == 1,\n    \"scale_up\", \"$1\", \"state\", \"(.*)\"\n  )\n)",
          "format": "table",
