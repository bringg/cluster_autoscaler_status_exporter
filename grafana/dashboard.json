{
  "uid": "cluster-autoscaler-status",
  "title": "Cluster Autoscaler Status",
  "description": "Cluster-autoscaler state recovered from the cluster-autoscaler-status ConfigMap by cluster_autoscaler_status_exporter.",
  "tags": [
    "kubernetes",
    "cluster-autoscaler",
    "prometheus"
  ],
  "schemaVersion": 41,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "options": [],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(cluster_autoscaler_status_up, job)",
        "query": {
          "qryType": 1,
          "query": "label_values(cluster_autoscaler_status_up, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {},
        "options": [],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1
      },
      {
        "name": "node_group",
        "label": "Node group",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(cluster_autoscaler_status_node_group_max_size{job=\"$job\"}, node_group)",
        "query": {
          "qryType": 1,
          "query": "label_values(cluster_autoscaler_status_node_group_max_size{job=\"$job\"}, node_group)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "allValue": ".*",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Exporter",
      "description": "cluster_autoscaler_status_up. 0 means the ConfigMap could not be fetched or parsed \u2014 every other metric is absent for that scrape.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "min(cluster_autoscaler_status_up{job=\"$job\"})",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "Down"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "Up"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Autoscaler",
      "description": "The state the cluster-autoscaler reports for itself.",
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "cluster_autoscaler_status_autoscaler_state{job=\"$job\"} == 1",
          "instant": true,
          "range": false,
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "No data",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cluster health",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "cluster_autoscaler_status_health_state{job=\"$job\", state=\"Healthy\"}",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "Unhealthy"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "Healthy"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
